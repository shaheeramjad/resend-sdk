# Webhooks

guide: entity: webhook: path: {
  "/webhooks": op: {
    create: method: "POST"
    list: { method: "GET", transform: res: "`body.data`" }
  }
  "/webhooks/{webhook_id}": op: update: method: "PATCH"
  "/webhooks/{webhook_id}/signing-secret/rotate": {
    action: rotate: {}
    rename: param: webhook_id: "id"
    op: create: method: "POST"
  }
}
guide: entity: update_webhook: active: false
guide: entity: rotate: active: false

