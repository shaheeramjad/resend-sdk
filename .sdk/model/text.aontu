# README wording — YOURS. The scaffold creates this file once and never
# overwrites it.
#
# A slot set here words the generated README files over the same slot of
# main.kit.info, where apidef puts the spec's metadata. A slot left out keeps
# the spec's wording. Text edited into a generated README is lost on the next
# generate; text here is not.
#
#   main: kit: text: {
#     tagline: 'Payments, invoices and refunds from TypeScript, Go and Python.'
#     summary: 'Acme Pay is a payments API for marketplaces.'
#     entity_desc: { invoice: 'A bill sent to a customer.' }
#   }
#
# The slots are title, summary, website, tagline, about_md, homepage,
# docs_url, meta_source and entity_desc. Any other key fails the model build.

main: kit: text: {
  tagline: 'Send email, manage domains, contacts and broadcasts on Resend from TypeScript, Python and Go.'
  docs_url: 'https://resend.com/docs/api-reference/introduction'
  about_md: `
Resend is an email API for developers: transactional email, domains, contacts,
segments, broadcasts, templates, webhooks and inboxes. This SDK covers all 89
paths of the official [Resend OpenAPI spec](https://github.com/resend/resend-openapi)
(v1.5.1) as 41 entities.

The entity grouping is corrected in [.sdk/model/guide/guide.aontu](.sdk/model/guide/guide.aontu).
A live smoke test against api.resend.com is in [live/smoke.js](live/smoke.js),
and notes on building this SDK with the Voxgig generator are in [REPORT.md](REPORT.md).
`
  entity_desc: {
    email: 'A transactional email sent through Resend.'
    domain: 'A sending domain and its DNS verification state.'
    contact: 'A person on your contact list.'
    broadcast: 'A marketing email sent to a segment.'
    webhook: 'An endpoint Resend posts delivery events to.'
  }
}
